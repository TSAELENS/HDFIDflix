{% extends 'base.html.twig' %}

{% block title %}
	Recherche - HDFIDflix
{% endblock %}

{% block body %}

	<div class="container py-5 search-page">

		{# ================================================================== #}
		{#                         BARRE DE RECHERCHE                         #}
		{# ================================================================== #}

			<section class="pt-3 pb-5"> <p class="text-hdfid-green text-uppercase fw-bold small mb-2">
				Explorer le catalogue
			</p>

			<h1 class="display-6 fw-bold text-white mb-4">
				Rechercher
			</h1>

			<div class="hero-search">

				{{ form_start(form, {
                    action: path('app_search'),
                    method: 'GET'
                }) }}

				{{ form_widget(form.query, {
                        attr: {
                            class: 'form-control hero-search-input shadow-none',
                            placeholder: 'Rechercher un film, une série, une personne...',
                            value: query
                        }
                    }) }}

				<button type="submit" class="btn btn-hdfid rounded-4 shadow-sm hero-search-button d-flex align-items-center justify-content-center" aria-label="Rechercher">
					<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewbox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
						<circle cx="11" cy="11" r="7"></circle>
						<path d="m20 20-4-4"></path>
					</svg>
				</button>

				{{ form_end(form) }}

			</div>

		</section>

		{% if query %}

			{% set totalResults =
                resultCounts.movie
                + resultCounts.tv
                + resultCounts.person
                + resultCounts.other
            %}

			{# ================================================================== #}
			{#                        TITRE DES RÉSULTATS                         #}
			{# ================================================================== #}

				<section class="pb-4"> <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end gap-3 mb-4">

					<div>


						<h2 class="h3 fw-bold text-white mb-0">
							Résultats pour
							<span class="text-hdfid-green">
								«
								{{ query }}
								»
							</span>
						</h2>

					</div>

					<p class="text-white-50 mb-0">
						{{ totalResults }}
						résultat{{ totalResults > 1 ? 's' : '' }}
					</p>

				</div>

				{# ============================================================== #}
				{#                            ONGLETS                             #}
				{# ============================================================== #}

					<nav class="nav nav-pills flex-nowrap gap-2 overflow-auto pb-2 search-tabs" aria-label="Catégories des résultats"> <a href="{{ path('app_search', { query: query, type: 'movie' }) }}" class="nav-link search-tab rounded-4 d-flex align-items-center gap-3 px-4 py-3 {{ selectedType == 'movie' ? 'active' : '' }}" data-turbo-prefetch="false">
						<span class="fw-semibold">
							Films
						</span>

						<span class="badge rounded-pill {{ selectedType == 'movie' ? 'text-bg-dark' : 'text-bg-secondary' }}">
							{{ resultCounts.movie }}
						</span>
					</a>

					<a href="{{ path('app_search', { query: query, type: 'tv' }) }}" class="nav-link search-tab rounded-4 d-flex align-items-center gap-3 px-4 py-3 {{ selectedType == 'tv' ? 'active' : '' }}" data-turbo-prefetch="false">
						<span class="fw-semibold">
							Séries
						</span>

						<span class="badge rounded-pill {{ selectedType == 'tv' ? 'text-bg-dark' : 'text-bg-secondary' }}">
							{{ resultCounts.tv }}
						</span>
					</a>

					<a href="{{ path('app_search', { query: query, type: 'person' }) }}" class="nav-link search-tab rounded-4 d-flex align-items-center gap-3 px-4 py-3 {{ selectedType == 'person' ? 'active' : '' }}" data-turbo-prefetch="false">
						<span class="fw-semibold">
							Personnes
						</span>

						<span class="badge rounded-pill {{ selectedType == 'person' ? 'text-bg-dark' : 'text-bg-secondary' }}">
							{{ resultCounts.person }}
						</span>
					</a>

					<a href="{{ path('app_search', { query: query, type: 'other' }) }}" class="nav-link search-tab rounded-4 d-flex align-items-center gap-3 px-4 py-3 {{ selectedType == 'other' ? 'active' : '' }}" data-turbo-prefetch="false">
						<span class="fw-semibold">
							Autres
						</span>

						<span class="badge rounded-pill {{ selectedType == 'other' ? 'text-bg-dark' : 'text-bg-secondary' }}">
							{{ resultCounts.other }}
						</span>
					</a>

				</nav>

			</section>

			{# ================================================================== #}
			{#                         CARTES DES RÉSULTATS                        #}
			{# ================================================================== #}

				<section class="pb-5 search-results"> {% if results is empty %}

					<div class="rounded-4 border border-secondary border-opacity-25 text-center px-4 py-5">

						<svg xmlns="http://www.w3.org/2000/svg" width="42" height="42" fill="none" viewbox="0 0 24 24" stroke="currentColor" stroke-width="1.5" class="text-white-50 mb-3" aria-hidden="true">
							<circle cx="11" cy="11" r="7"></circle>
							<path d="m20 20-4-4"></path>
						</svg>

						<h3 class="h5 fw-bold text-white">
							Aucun résultat dans cette catégorie
						</h3>

						<p class="text-white-50 mb-0">
							Essayez une autre catégorie ou une nouvelle recherche.
						</p>

					</div>

				{% else %}

					<div class="row g-4">

						{% for result in results %}

							{% set title = result.title ?? result.name ?? 'Sans titre' %}
							{% set image = result.poster_path ?? result.profile_path ?? null %}
							{% set date = result.release_date ?? result.first_air_date ?? null %}
							{% set detailsPath = null %}
							{% set typeLabel = 'Autre' %}

							{% if selectedType == 'movie' %}

								{% set detailsPath = path('app_movie_details', {
                                    id: result.id
                                }) %}

								{% set typeLabel = 'Film' %}

							{% elseif selectedType == 'tv' %}

								{% set detailsPath = path('app_tv_details', {
                                    id: result.id
                                }) %}

								{% set typeLabel = 'Série' %}

							{% elseif selectedType == 'person' %}

								{% set detailsPath = path('app_person_details', {
                                    id: result.id
                                }) %}

								{% set typeLabel = 'Personne' %}

							{% endif %}

							<div class="col-6 col-md-4 col-lg-3 col-xl-2">

								{% if detailsPath %}
									<a href="{{ detailsPath }}" class="text-decoration-none d-block h-100" data-turbo-prefetch="false">
									{% endif %}

									<article class="media-card h-100">

										<div class="media-card-image-wrapper rounded-4 overflow-hidden shadow">

											{% if image %}

												<img src="https://image.tmdb.org/t/p/w500{{ image }}" class="media-card-image" alt="{{ title }}">

											{% else %}

												<div class="media-card-image d-flex align-items-center justify-content-center bg-secondary text-white-50 text-center p-3">
													Image indisponible
												</div>

											{% endif %}

											<div class="media-card-overlay"></div>

										</div>

										<div class="pt-3 px-1">

											<h3 class="h6 fw-bold text-white text-truncate mb-1">
												{{ title }}
											</h3>

											<p class="small text-white-50 mb-0">
												{% if date %}
													{{ date|date('Y') }}
												{% else %}
													{{ typeLabel }}
												{% endif %}
											</p>

										</div>

									</article>

									{% if detailsPath %}
									</a>
								{% endif %}

							</div>

						{% endfor %}

					</div>

				{% endif %}

			</section>

		{% endif %}

	</div>

{% endblock %}

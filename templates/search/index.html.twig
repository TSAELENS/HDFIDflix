{% extends 'base.html.twig' %}

{% block title %}HDFIDflix
{% endblock %}

{% block body %}


	<section class="py-4">
		<div class="row justify-content-center">
			<div class="col-12 col-md-8 col-lg-6">
				{{ form_start(form, {
        action: path('app_search'),
        method: 'GET'
    }) }}

				<div class="input-group input-group-lg">
					{{ form_widget(form.query, {
            attr: {
                class: 'form-control',
                placeholder: 'Rechercher un film, une série, une personne...',
                value: query
            }
        }) }}

					<button type="submit" class="btn btn-danger">
						Rechercher
					</button>
				</div>

				{{ form_end(form) }}
			</div>
		</div>
	</section>

	<section class="py-4">
		{% if query %}
			<h1 class="h3 mb-4">
				Résultats pour :
				<span class="text-danger">{{ query }}</span>
			</h1>

			<div class="row g-4">
				<aside class="col-12 col-lg-3">
					<div class="card border-secondary">
						<div class="card-header bg-danger text-white fw-bold py-3">
							Résultats de votre recherche
						</div>

						<div class="list-group list-group-flush">
							<a href="{{ path('app_search', { query: query, type: 'movie' }) }}" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center {{ selectedType == 'movie' ? 'active' : '' }}">
								Films

								<span class="badge rounded-pill text-bg-secondary">
									{{ resultCounts.movie }}
								</span>
							</a>

							<a href="{{ path('app_search', { query: query, type: 'tv' }) }}" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center {{ selectedType == 'tv' ? 'active' : '' }}">
								Séries

								<span class="badge rounded-pill text-bg-secondary">
									{{ resultCounts.tv }}
								</span>
							</a>

							<a href="{{ path('app_search', { query: query, type: 'person' }) }}" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center {{ selectedType == 'person' ? 'active' : '' }}">
								Personnes

								<span class="badge rounded-pill text-bg-secondary">
										{{ resultCounts.person }}
								</span>
							</a>

                            
							</a>


							<a href="{{ path('app_search', {query: query, type: 'other'	}) }}" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center {{ selectedType == 'other' ? 'active' : '' }}">
								Autres

								<span class="badge rounded-pill text-bg-secondary">
									{{ resultCounts.other }}
								</span>
							</a>
						</div>
					</div>
				</aside>

				<div class="col-12 col-lg-9">
					{% if results is empty %}
						<p class="text-secondary">
							Aucun résultat trouvé dans cette catégorie.
						</p>
					{% else %}
						<div class="row g-4">
                        {% for result in results %}
                            {% set title = result.title ?? result.name ?? 'Sans titre' %}
                            {% set image = result.poster_path ?? result.profile_path ?? null %}
                            {% set detailsPath = null %}

                            {% if selectedType == 'movie' %}
                                {% set detailsPath = path('app_movie_details', {
                                    id: result.id
                                }) %}

                            {% elseif selectedType == 'tv' %}
                                {% set detailsPath = path('app_tv_details', {
                                    id: result.id
                                }) %}

                            {% elseif selectedType == 'person' %}
                                {% set detailsPath = path('app_person_details', {
                                    id: result.id
                                }) %}

                            {% endif %}

                            <div class="col-12 col-md-6 col-xl-4">
                                {% if detailsPath %}
                                    <a
                                        href="{{ detailsPath }}"
                                        class="text-decoration-none"
                                    >
                                {% endif %}

                                <article class="card h-100 bg-dark text-light border-secondary">
                                    {% if image %}
                                        <div
                                            class="ratio"
                                            style="--bs-aspect-ratio: 150%;"
                                        >
                                            <img
                                                src="https://image.tmdb.org/t/p/w500{{ image }}"
                                                class="card-img-top object-fit-cover"
                                                alt="{{ title }}"
                                            >
                                        </div>
                                    {% else %}
                                        <div
                                            class="ratio bg-secondary-subtle text-secondary"
                                            style="--bs-aspect-ratio: 150%;"
                                        >
                                            <div class="d-flex align-items-center justify-content-center">
                                                <div class="text-center">
                                                    <div class="fs-1 mb-2">🖼️</div>
                                                    <div>Image non disponible</div>
                                                </div>
                                            </div>
                                        </div>
                                    {% endif %}

                                    <div class="card-body">
                                        <span class="badge bg-secondary mb-2">
                                            {% if selectedType == 'movie' %}
                                                Film
                                            {% elseif selectedType == 'tv' %}
                                                Série
                                            {% elseif selectedType == 'person' %}
                                                Personne
                                            {% else %}
                                                Autre
                                            {% endif %}
                                        </span>

                                        <h2 class="h5">
                                            {{ title }}
                                        </h2>
                                    </div>
                                </article>

                                {% if detailsPath %}
                                    </a>
                                {% endif %}
                            </div>
                        {% endfor %}
						</div>
					{% endif %}
				</div>
			</div>
		{% endif %}
	</section>
{% endblock %}

{% extends 'base.html.twig' %}

{% block title %}Recherche - HDFIDflix
{% endblock %}

{% block body %}


	<section class="py-4">
		<div class="row justify-content-center">
			<div class="col-12 col-md-8 col-lg-6">
				{{ form_start(form, {
        action: path('app_search'),
        method: 'GET'
    }) }}

				<div class="input-group input-group-lg">
					{{ form_widget(form.query, {
            attr: {
                class: 'form-control',
                placeholder: 'Rechercher un film, une série, une personne...'
            }
        }) }}

					<button type="submit" class="btn btn-danger">
						Rechercher
					</button>
				</div>

				{{ form_end(form) }}
			</div>
		</div>
	</section>

	<section class="py-4">

		{% if query %}
			<h1 class="mb-4">
				Résultats pour :
				<span class="text-danger">{{ query }}</span>
			</h1>
		{% endif %}

		{% if results is empty %}
			<p class="text-secondary">
				Aucun résultat trouvé.
			</p>
		{% else %}


			<div class="row g-4">
				{% for result in results %}

					{% set title = result.title ?? result.name ?? 'Sans titre' %}
					{% set image = result.poster_path ?? result.profile_path ?? null %}

					<div class="col-12 col-md-6 col-lg-3">
						<div class="card h-100 bg-dark text-light border-secondary">

							{% if image %}
								<img src="https://image.tmdb.org/t/p/w500{{ image }}" class="card-img-top" alt="{{ title }}">
							{% endif %}

							<div class="card-body">
								<span class="badge bg-secondary mb-2">
									{% if result.media_type == 'movie' %}
										Film
									{% elseif result.media_type == 'tv' %}
										Série
									{% elseif result.media_type == 'person' %}
										Personne
									{% endif %}
								</span>

								<h2 class="h5">
									{{ title }}
								</h2>

							</div>
						</div>
					</div>

				{% endfor %}
			</div>

		{% endif %}

	</section>
{% endblock %}

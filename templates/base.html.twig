<!DOCTYPE html>
<html lang="fr">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1">

		<title>
			{% block title %}HDFIDflix
			{% endblock %}
		</title>

		{% block stylesheets %}{% endblock %}

		{% block javascripts %}
			{% block importmap %}
				{{ importmap('app') }}
			{% endblock %}
		{% endblock %}
	</head>

	{% set isHome = app.request.attributes.get('_route') == 'app_home' %}

	<body class="bg-dark text-light {{ isHome ? 'home-page' : '' }}">

    {# ====================================================================== #}
    {#                              NAVBAR                                #}
    {# ====================================================================== #}

		<nav class="navbar navbar-expand-lg navbar-dark cinema-navbar py-3">
			<div class="container">

				<a
					class="navbar-brand cinema-brand"
					href="{{ path('app_home') }}"
				>
					HDFID<span>flix</span>
				</a>

				<button
					class="navbar-toggler border-0 shadow-none"
					type="button"
					data-bs-toggle="collapse"
					data-bs-target="#mainNavigation"
					aria-controls="mainNavigation"
					aria-expanded="false"
					aria-label="Ouvrir le menu"
				>
					<span class="navbar-toggler-icon"></span>
				</button>

				<div
					class="collapse navbar-collapse"
					id="mainNavigation"
				>
					<ul class="navbar-nav ms-auto align-items-lg-center gap-lg-4">

						<li class="nav-item">
							<a
								class="nav-link {{ isHome ? 'active' : '' }}"
								href="{{ path('app_home') }}"
							>
								Accueil
							</a>
						</li>

						<li class="nav-item">
							<a
								class="nav-link {{ app.request.attributes.get('_route') == 'app_search' ? 'active' : '' }}"
								href="{{ path('app_search') }}"
							>
								Rechercher
							</a>
						</li>

					</ul>
				</div>

			</div>
		</nav>

		<main>
			{% block body %}

			{% endblock %}
		</main>
	</body>
</html>

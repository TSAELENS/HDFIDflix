{% extends 'base.html.twig' %}

{% block title %}HDFIDflix
{% endblock %}

{% block body %}

	{# Film mis en avant #}
	{% set featuredMovie = popularMovies is defined and popularMovies
        ? popularMovies|first
        : null
    %}

	{# ========================================================================== #}
	{#                         HERO DE LA PAGE D’ACCUEIL                          #}
	{# ========================================================================== #}

		<section class="home-hero position-relative d-flex align-items-center" {% if featuredMovie and featuredMovie.backdrop_path %} style="background-image: url('https://image.tmdb.org/t/p/original{{ featuredMovie.backdrop_path }}');" {% endif %}> <div class="home-hero-overlay"></div>

		<div class="container home-hero-content py-5">
			<div class="row">
				<div class="col-12 col-lg-7">

					<p class="text-hdfid-green text-uppercase fw-bold small mb-3">
						À découvrir sur HDFIDflix
					</p>

					<h1 class="display-3 fw-bold text-white mb-3">
						{{ featuredMovie.title ?? 'Trouvez votre prochain film' }}
					</h1>

					{% if featuredMovie and featuredMovie.overview %}
						<p class="lead hero-description mb-4">
							{{ featuredMovie.overview|slice(0, 240) }}

							{% if featuredMovie.overview|length > 240 %}
								…
							{% endif %}
						</p>
					{% else %}
						<p class="lead hero-description mb-4">
							Découvrez les films, séries et personnalités
																																																								                            qui font l’actualité.
						</p>
					{% endif %}

					<div class="hero-actions d-flex flex-column gap-3">

						{% if featuredMovie %}
							<a href="{{ path('app_movie_details', { id: featuredMovie.id }) }}" class="btn btn-hdfid rounded-4 shadow-sm px-4 py-3 align-self-start" data-turbo-prefetch="false">
								Voir la fiche
							</a>
						{% endif %}

						{# Recherche du hero #}
						<div class="hero-search">
							{{ form_start(form) }}

							{{ form_widget(form.query, {
									attr: {
										class: 'form-control hero-search-input shadow-none',
										placeholder: 'Rechercher un film, une série, une personne...'
									}
								}) }}

							<button type="submit" class="btn btn-hdfid rounded-4 shadow-sm hero-search-button d-flex align-items-center justify-content-center" aria-label="Rechercher">
								<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewbox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
									<circle cx="11" cy="11" r="7"></circle>
									<path d="m20 20-4-4"></path>
								</svg>
							</button>

							{{ form_end(form) }}
						</div>

					</div>

				</div>
			</div>
		</div>
	</section>

	{# ========================================================================== #}
	{#                           FILMS POPULAIRES                                 #}
	{# ========================================================================== #}

		<div class="home-content"> <div class="container py-5">
			{% if popularMovies %}
				<section class="mt-2 mb-10">

					<h2 class="h3 fw-bold text-white d-flex align-items-center gap-3 mb-4">
						<span class="section-title-accent"></span>
						Films populaires
					</h2>

					<div class="d-flex gap-3 overflow-auto pt-3 pb-3 media-row">

						{% for movie in popularMovies|slice(0, 15) %}

							<a href="{{ path('app_movie_details', { id: movie.id }) }}" class="text-decoration-none flex-shrink-0" data-turbo-prefetch="false">
								<article class="media-card">

									<div class="media-card-image-wrapper rounded-4 overflow-hidden shadow">
										{% if movie.poster_path %}
											<img src="https://image.tmdb.org/t/p/w500{{ movie.poster_path }}" class="media-card-image" alt="{{ movie.title }}">
										{% else %}
											<div class="media-card-image d-flex align-items-center justify-content-center bg-secondary text-white text-center p-3">
												Image indisponible
											</div>
										{% endif %}

										<div class="media-card-overlay"></div>
									</div>

									<div class="pt-3 px-1">
										<h3 class="h6 fw-bold text-white text-truncate mb-1">
											{{ movie.title }}
										</h3>

										{% if movie.release_date %}
											<p class="small text-white-50 mb-0">
												{{ movie.release_date|date('Y') }}
											</p>
										{% endif %}
									</div>

								</article>
							</a>

						{% endfor %}

					</div>

				</section>
			{% endif %}

			{# ========================================================================== #}
			{#                          SÉRIES POPULAIRES                                  #}
			{# ========================================================================== #}

				{% if popularTv %}
					<section class="mt-4 mb-5"> <h2 class="h3 fw-bold text-white d-flex align-items-center gap-3 mb-4">
						<span class="section-title-accent"></span>
						Séries populaires
					</h2>

					<div class="d-flex gap-3 overflow-auto pt-3 pb-3 media-row">

						{% for tv in popularTv|slice(0, 15) %}
							<a href="{{ path('app_tv_details', { id: tv.id }) }}" class="text-decoration-none flex-shrink-0" data-turbo-prefetch="false">
								<article class="media-card">

									<div class="media-card-image-wrapper rounded-4 overflow-hidden shadow">
										{% if tv.poster_path %}
											<img src="https://image.tmdb.org/t/p/w500{{ tv.poster_path }}" class="media-card-image" alt="{{ tv.name }}">
										{% else %}
											<div class="media-card-image d-flex align-items-center justify-content-center bg-secondary text-white text-center p-3">
												Image indisponible
											</div>
										{% endif %}

										<div class="media-card-overlay"></div>
									</div>

									<div class="pt-3 px-1">
										<h3 class="h6 fw-bold text-white text-truncate mb-1">
											{{ tv.name }}
										</h3>

										{% if tv.first_air_date %}
											<p class="small text-white-50 mb-0">
												{{ tv.first_air_date|date('Y') }}
											</p>
										{% endif %}
									</div>

								</article>
							</a>
						{% endfor %}

					</div>

				</section>
			{% endif %}

			{# ========================================================================== #}
			{#                        FILMS LES MIEUX NOTÉS                                #}
			{# ========================================================================== #}

				{% if topRatedMovies %}
					<section class="mt-4 mb-5"> <h2 class="h3 fw-bold text-white d-flex align-items-center gap-3 mb-4">
						<span class="section-title-accent"></span>
						Films les mieux notés
					</h2>

					<div class="d-flex gap-3 overflow-auto pt-3 pb-3 media-row">

						{% for movie in topRatedMovies|slice(0, 15) %}
							<a href="{{ path('app_movie_details', { id: movie.id }) }}" class="text-decoration-none flex-shrink-0" data-turbo-prefetch="false">
								<article class="media-card">

									<div class="media-card-image-wrapper rounded-4 overflow-hidden shadow">
										{% if movie.poster_path %}
											<img src="https://image.tmdb.org/t/p/w500{{ movie.poster_path }}" class="media-card-image" alt="{{ movie.title }}">
										{% else %}
											<div class="media-card-image d-flex align-items-center justify-content-center bg-secondary text-white text-center p-3">
												Image indisponible
											</div>
										{% endif %}

										<div class="media-card-overlay"></div>
									</div>

									<div class="pt-3 px-1">
										<h3 class="h6 fw-bold text-white text-truncate mb-1">
											{{ movie.title }}
										</h3>

										{% if movie.release_date %}
											<p class="small text-white-50 mb-0">
												{{ movie.release_date|date('Y') }}
											</p>
										{% endif %}
									</div>

								</article>
							</a>
						{% endfor %}

					</div>

				</section>
			{% endif %}

		</div>
	</div>
{% endblock %}
